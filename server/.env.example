# PostgreSQL Connection (Supabase Session Pooler on port 5432 for IPv4 compatibility)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# JWT Secrets (generate strong random secrets for production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"

# Server Port (Render sets PORT automatically; defaults to 3001 locally)
PORT=3001

# Allowed Frontend URL(s) for CORS (supports comma-separated list of URLs)
FRONTEND_URL="http://localhost:5173,https://your-project.vercel.app"
